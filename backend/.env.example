# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host.region.aws.neon.tech/neondb

# Security
SECRET_KEY=your-super-secret-jwt-key

# Email Alerts: Brevo HTTPS API (Recommended for Cloud / Render - Port 443, 300 free emails/day)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_email@gmail.com

# Email Alerts: Local SMTP Fallback (For local dev; blocked on Render Free Tier)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Optional Configuration
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,https://uptime-sentinel-six.vercel.app