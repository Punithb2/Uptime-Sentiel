# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host.region.aws.neon.tech/neondb

# Security
SECRET_KEY=your-super-secret-jwt-key

# Email Alerts (Production HTTPS API via Resend - recommended for Render/Cloud)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=UptimeSentinel <onboarding@resend.dev>

# Alternative Email Alerts (Local SMTP Fallback - blocked on Render Free Tier)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password