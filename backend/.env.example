# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@host.region.aws.neon.tech/neondb

# Security
SECRET_KEY=your-super-secret-jwt-key

# Option 1: Email Alerts without custom domain (Brevo HTTPS API - 300 emails/day to anyone free)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_email@gmail.com

# Option 2: Email Alerts with custom domain (Resend HTTPS API)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=UptimeSentinel <alerts@yourdomain.com>

# Option 3: Local SMTP Fallback (Blocked on Render Free Tier)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password